// Slice 001 — Identity/Tenant/sessão server-side (ADR-009).
// 1 usuário = 1 tenant/workspace pessoal. Sessão guarda apenas hash da referência opaca.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  tenant       Tenant?
  sessions     Session[]

  @@map("users")
}

model Tenant {
  id          String       @id @default(uuid())
  userId      String       @unique
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  sessions    Session[]
  products    Product[]
  entitlement Entitlement?
  idempotencyRecords IdempotencyRecord[]
  generationIntents GenerationIntent[]
  generationRuns GenerationRun[]
  usageReservations GenerationUsageReservation[]
  strategies Strategy[]
  plans Plan[]
  contents Content[]

  @@map("tenants")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tenantId  String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@map("sessions")
}

// Slice 002 — Product manual-first (ADR-008), entitlement default (ADR-006), idempotência de criação.

model Product {
  id               String    @id @default(uuid())
  tenantId         String
  name             String
  description      String
  category         String?
  priceCents       BigInt?
  features         Json?
  imageRefs        Json?
  notes            String?
  url              String?
  locale           String    @default("pt-BR")
  active           Boolean   @default(true)
  version          Int       @default(1)
  enrichmentStatus String    @default("none") // none | pending | completed | unavailable
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  context          ProductContext?
  idempotencyRecords IdempotencyRecord[]
  generationRuns   GenerationRun[]
  strategies       Strategy[]
  plans            Plan[]
  contents         Content[]

  @@index([tenantId])
  @@map("products")
}

model ProductContext {
  id              String   @id @default(uuid())
  productId       String   @unique
  goal            String? // objetivo
  audience        String? // público
  style           String? // estilo
  creatorPresence String? // presença do creator
  experience      String? // experiência
  constraints     String? // restrições
  market          String? // mercado
  notes           String? // observações
  locale          String   @default("pt-BR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id])

  @@map("product_contexts")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  tenantId       String
  idempotencyKey String
  payloadHash    String
  productId      String
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model Entitlement {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("entitlements")
}

model GenerationWorkerState {
  id              String   @id // singleton "default"
  lastHeartbeatAt DateTime
  updatedAt       DateTime @updatedAt

  @@map("generation_worker_state")
}

model GenerationIntent {
  id                String        @id @default(uuid())
  tenantId          String
  idempotencyKey    String
  intentFingerprint String
  inputSnapshotHash String
  generationRunId   String        @unique
  createdAt         DateTime      @default(now())
  expiresAt         DateTime
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  generationRun     GenerationRun @relation(fields: [generationRunId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("generation_intents")
}

model GenerationRun {
  id                 String        @id @default(uuid())
  tenantId           String
  productId          String
  operation          String
  status             String        @default("queued")
  quantity           Int
  objective          String?
  contractVersion    String        @default("1")
  inputSnapshot      Json
  inputSnapshotHash  String
  historySnapshot    Json
  attemptCount       Int           @default(0)
  leaseToken         String?
  leaseExpiresAt     DateTime?
  nextAttemptAt      DateTime      @default(now())
  queuedAt           DateTime      @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  lastError          String?
  previousRunId      String?
  engineVersion      String?
  provider           String?
  model              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  product            Product       @relation(fields: [productId], references: [id])
  previousRun        GenerationRun? @relation("GenerationRetry", fields: [previousRunId], references: [id])
  retryRuns          GenerationRun[] @relation("GenerationRetry")
  intents            GenerationIntent[]
  usageReservation   GenerationUsageReservation?
  strategy           Strategy?
  plan               Plan?
  contents           Content[]

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@map("generation_runs")
}

model GenerationUsageReservation {
  id             String        @id @default(uuid())
  tenantId       String
  generationRunId String       @unique
  periodStart    DateTime
  quantity       Int
  status         String        @default("reserved")
  reason         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  releasedAt     DateTime?
  confirmedAt    DateTime?
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  generationRun  GenerationRun @relation(fields: [generationRunId], references: [id])

  @@index([tenantId, periodStart, status])
  @@map("generation_usage_reservations")
}

model Strategy {
  id                String        @id @default(uuid())
  tenantId          String
  productId         String
  generationRunId   String        @unique
  contractVersion   String        @default("1")
  payload           Json
  provenance        Json
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  product           Product       @relation(fields: [productId], references: [id])
  generationRun     GenerationRun @relation(fields: [generationRunId], references: [id])
  plan              Plan?
  contents          Content[]

  @@index([tenantId, productId])
  @@map("strategies")
}

model Plan {
  id                String        @id @default(uuid())
  tenantId          String
  productId         String
  generationRunId   String        @unique
  strategyId        String        @unique
  contractVersion   String        @default("1")
  payload           Json
  provenance        Json
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  product           Product       @relation(fields: [productId], references: [id])
  generationRun     GenerationRun @relation(fields: [generationRunId], references: [id])
  strategy          Strategy      @relation(fields: [strategyId], references: [id])
  contents          Content[]

  @@index([tenantId, productId])
  @@map("plans")
}

model Content {
  id             String        @id @default(uuid())
  tenantId       String
  productId      String
  generationRunId String
  strategyId     String
  planId         String
  position       Int
  audienceId     String
  painId         String
  desireId       String? // SPEC: desejo OU benefício — ao menos um (CHECK no banco)
  benefitId      String?
  objectionId    String?
  angleId        String
  hook           String
  normalizedHook String
  structure      String
  script         String
  scenes         Json
  cta            String
  explanation    String
  provenance     Json
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])
  generationRun  GenerationRun @relation(fields: [generationRunId], references: [id])
  strategy       Strategy      @relation(fields: [strategyId], references: [id])
  plan           Plan          @relation(fields: [planId], references: [id])

  @@unique([generationRunId, position])
  @@unique([generationRunId, normalizedHook])
  @@index([tenantId, productId])
  @@map("contents")
}
