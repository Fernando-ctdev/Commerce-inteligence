ENTITLEMENT_ACTIVE_PRODUCTS=5

# Browser Service (fail-closed: sem URL/token não há importação automática)
BROWSER_SERVICE_URL="http://127.0.0.1:8081"
BROWSER_SERVICE_TOKEN="change-me-with-at-least-16-characters"
BROWSER_IMPORT_ALLOWED_HOSTS="shop.tiktok.com,*.tiktok.com"
BROWSER_SERVICE_TIMEOUT_MS=30000
BROWSER_IMPORT_ATTEMPT_TTL_MINUTES=30
BROWSER_IMPORT_CANDIDATE_TTL_HOURS=24

# LLM fallback factual (server-only; provider ausente/inválido falha fechado)
